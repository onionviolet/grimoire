# Radiance HDR environment probes are binary (RGBE data). Git misdetects them as
# text because there's no NUL byte early in the file, so with core.autocrlf it
# would insert CR bytes on checkout and corrupt the probe. Force binary handling.
*.hdr binary

# ChatLane data is hash-pinned by scripts/check-chatlane-resources.mjs. With
# core.autocrlf (the Git for Windows default) a checkout would add CR bytes
# and fail that check on every Windows release build. Keep the bytes as committed.
resources/chatlane/base-commands.json -text
resources/chatlane/red2.bin binary

# The original ChatLane VPK fixtures embed these YAML files with LF endings.
resources/chatlane/starter.yml text eol=lf
electron/main/services/fixtures/chatwheel/overrides.yml text eol=lf
